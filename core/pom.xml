<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vitorsilverio</groupId>
        <artifactId>arm-jitter-parent</artifactId>
        <version>1.4.0</version>
    </parent>

    <artifactId>arm-jitter</artifactId>
    <packaging>jar</packaging>
    <name>arm-jitter</name>
    <description>ARM/THUMB debug-friendly JIT runtime library for Java emulators.</description>

    <dependencies>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- Catraca de cobertura (E15.1, decisão D6 do épico E15): o piso é o valor MEDIDO
                         no build completo (`mvn verify`, com `target/jacoco.exec` novo), truncado para
                         baixo em 0,1pp. **O número só sobe**: quem aumenta a cobertura sobe o piso no
                         mesmo commit; baixar o piso para fazer o build passar não é uma opção — o
                         caminho é cobrir o código novo. Medição de 2026-10-02: linha 94,02%, branch
                         89,48%. A E15.22 fecha com os dois em 1.000.
                         Única exceção, decidida pelo usuário na E15.5 (2026-10-02): o piso de branch
                         desceu de 0,894 para 0,892 porque sair um `switch` COBERTO encolhe o denominador
                         (360 branches cobertos a menos) sem nenhum branch perdido a mais (2738 antes e
                         depois); medição: linha 94,00%, branch 89,26%. -->

                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.940</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.892</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
